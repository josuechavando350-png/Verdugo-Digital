  "source_review_scope": "Selected parser APIs, enum/object states, explicit configuration and bundled MIT JSON-schema class license read. Remaining installed code integrity checked only.",
  "operation_scope": [
    "Character-by-character allowed-set and completion checks over one fixed schema and deterministic bounded enum cases.",
    "Compare prefix viability, completion and first rejected offset with a separate two-document finite language."
  ],
  "limitations": [
    "No arbitrary schema or free text, tokenizer, weights, LLM generation, network, content truth or execution authorization.",
    "Optional numpy analyzer is absent; original package warns and exposes None for that analyzer. All mandatory dependencies installed.",
    "No exhaustive transitive license or security audit."
  ],
