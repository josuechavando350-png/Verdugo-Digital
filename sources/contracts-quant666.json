  "operation_scope": [
    "Native original float32 CPU quantize_blockwise and dequantize_blockwise with fixed block size 64.",
    "At most 512 synthetic integers; finite reconstruction, scalar codebook reference and numeric error reporting.",
    "Storage count includes uint8 array, float32 per-block scales and 256-entry float32 codebook."
  ],
  "limitations": [
    "No learned model or weights, GPU execution, accuracy calibration, speed benchmark or commercial outcome.",
    "Reconstruction loss is reported; exact reconstruction is not promised.",
    "Total byte count excludes Python object metadata and allocator overhead; it is not observed RAM use.",
    "Operator receipt, not independent attestation or binary reproducibility proof.",
    "Selected content reviewed; other files verified for integrity only."
  ],
