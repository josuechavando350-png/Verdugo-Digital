{
  "id": "executive666-demo",
  "steps": [
    {
      "id": "kernel",
      "service": "semantic-kernel",
      "operation": "objective.plan",
      "params": {
        "goal": {
          "dataset": "demo",
          "target_clients": 20,
          "horizon_days": 30,
          "budget_minor": 0,
          "currency": "MXN",
          "channels": [
            {
              "channel": "referral",
              "contacts_available": 300,
              "cost_per_contact_minor": 0,
              "history_contacts": 200,
              "history_clients": 20
            }
          ]
        },
        "dataset": "demo"
      }
    },
    {
      "id": "agno",
      "service": "agno",
      "operation": "objective.plan",
      "params": {
        "goal": {
          "dataset": "demo",
          "target_clients": 20,
          "horizon_days": 30,
          "budget_minor": 0,
          "currency": "MXN",
          "channels": [
            {
              "channel": "referral",
              "contacts_available": 300,
              "cost_per_contact_minor": 0,
              "history_contacts": 200,
              "history_clients": 20
            }
          ]
        },
        "dataset": "demo"
      }
    },
    {
      "id": "check",
      "service": "ag2",
      "operation": "actions.check",
      "params": {
        "dataset": "demo",
        "currency": "MXN",
        "budget_minor": {
          "$ref": "kernel.result.budget_minor"
        },
        "actions": [
          {
            "channel": "referral",
            "contacts": {
              "$ref": "agno.result.planned_contacts"
            },
            "cost_per_contact_minor": 0
          }
        ]
      },
      "depends_on": [
        "kernel",
        "agno"
      ]
    },
    {
      "id": "simulate",
      "service": "core",
      "operation": "objective.simulate",
      "params": {
        "goal": {
          "dataset": "demo",
          "target_clients": 20,
          "horizon_days": 30,
          "budget_minor": 0,
          "currency": "MXN",
          "channels": [
            {
              "channel": "referral",
              "contacts_available": 300,
              "cost_per_contact_minor": 0,
              "history_contacts": 200,
              "history_clients": 20
            }
          ]
        },
        "seed": 666
      },
      "depends_on": [
        "check"
      ]
    },
    {
      "id": "measure",
      "service": "core",
      "operation": "objective.measure",
      "params": {
        "simulation_key": "executive666-demo-simulate",
        "observed_contacts": 200,
        "observed_clients": 17,
        "dataset": "demo"
      },
      "depends_on": [
        "simulate"
      ]
    },
    {
      "id": "claims",
      "service": "langroid",
      "operation": "claims.check",
      "params": {
        "dataset": "demo",
        "currency": "MXN",
        "before": {
          "contacts": 200,
          "clients": 20,
          "spend_minor": 0,
          "revenue_minor": 0
        },
        "after": {
          "contacts": {
            "$ref": "measure.observed_contacts"
          },
          "clients": {
            "$ref": "measure.observed_clients"
          },
          "spend_minor": 0,
          "revenue_minor": 0
        },
        "claims": [
          "conversion_rate_increased",
          "cost_per_client_decreased",
          "revenue_above_ad_spend"
        ]
      },
      "depends_on": [
        "measure"
      ]
    },
    {
      "id": "scenarios",
      "service": "griptape",
      "operation": "objective.scenarios",
      "params": {
        "dataset": "demo",
        "goals": [
          {
            "dataset": "demo",
            "target_clients": 20,
            "horizon_days": 30,
            "budget_minor": 0,
            "currency": "MXN",
            "channels": [
              {
                "channel": "referral",
                "contacts_available": 300,
                "cost_per_contact_minor": 0,
                "history_contacts": 200,
                "history_clients": 20
              }
            ]
          },
          {
            "dataset": "demo",
            "target_clients": 20,
            "horizon_days": 30,
            "budget_minor": 0,
            "currency": "MXN",
            "channels": [
              {
                "channel": "referral",
                "contacts_available": 100,
                "cost_per_contact_minor": 0,
                "history_contacts": 200,
                "history_clients": 20
              }
            ]
          }
        ]
      }
    },
    {
      "id": "review",
      "service": "beeai-framework",
      "operation": "review.route",
      "params": {
        "dataset": "demo",
        "budget_ok": {
          "$ref": "check.result.within_budget"
        },
        "capacity_ok": {
          "$ref": "check.result.within_contact_limit"
        },
        "observed_clients": {
          "$ref": "measure.observed_clients"
        },
        "target_clients": 20
      },
      "depends_on": [
        "check",
        "measure"
      ]
    },
    {
      "id": "parallel",
      "service": "harness-sdk",
      "operation": "limits.parallel",
      "params": {
        "dataset": "demo",
        "budget_minor": 0,
        "capacity_contacts": 300,
        "actions": [
          {
            "contacts": 200,
            "cost_per_contact_minor": 0
          }
        ]
      }
    },
    {
      "id": "sequence",
      "service": "unified-planning",
      "operation": "sequence.validate",
      "depends_on": [
        "parallel"
      ],
      "params": {
        "dataset": "demo",
        "sequence": [
          "plan",
          "limits",
          "operator_review",
          "simulate",
          "measure"
        ],
        "limits_satisfied": {
          "$ref": "parallel.result.within_budget"
        },
        "hypothetical_review_available": true
      }
    },
    {
      "id": "measurement_review",
      "service": "voltagent",
      "operation": "measurement.review",
      "depends_on": [
        "simulate",
        "measure"
      ],
      "params": {
        "dataset": "demo",
        "target_clients": 20,
        "simulated_median": {
          "$ref": "simulate.clients_quantiles.p50"
        },
        "observed_clients": {
          "$ref": "measure.observed_clients"
        },
        "observed_contacts": {
          "$ref": "measure.observed_contacts"
        }
      }
    },
    {
      "id": "memory",
      "service": "servers",
      "operation": "graph.audit",
      "params": {
        "dataset": "demo",
        "statuses": [
          "completed",
          "blocked",
          "not_started"
        ],
        "edges": [
          [
            0,
            1
          ],
          [
            2,
            1
          ],
          [
            0,
            1
          ]
        ],
        "query": "blocked"
      }
    },
    {
      "id": "monty",
      "service": "monty",
      "operation": "budget.evaluate",
      "params": {
        "dataset": "demo",
        "budget_minor": {
          "$ref": "kernel.result.budget_minor"
        },
        "capacity_contacts": 300,
        "actions": [
          {
            "contacts": {
              "$ref": "check.result.planned_contacts"
            },
            "cost_per_contact_minor": 0
          }
        ]
      },
      "depends_on": [
        "kernel",
        "check"
      ]
    },
    {
      "id": "cookie_state",
      "service": "playwright-python",
      "operation": "cookies.check",
      "params": {
        "dataset": "demo",
        "cookies": [
          {
            "slot": 0,
            "secure": true,
            "http_only": true,
            "same_site": "Strict",
            "lifetime": "session"
          },
          {
            "slot": 1,
            "secure": false,
            "http_only": false,
            "same_site": "None",
            "lifetime": "session"
          },
          {
            "slot": 2,
            "secure": true,
            "http_only": false,
            "same_site": "Lax",
            "lifetime": "expired"
          }
        ]
      },
      "depends_on": [
        "memory"
      ]
    },
    {
      "id": "dispatch_policy",
      "service": "hatchet",
      "operation": "policy.compile",
      "depends_on": [
        "measurement_review"
      ],
      "params": {
        "dataset": "demo",
        "operation_kind": "write",
        "previous_state": "uncertain",
        "max_parallel": 2,
        "requested_retries": 3,
        "timeout_seconds": 30,
        "retention_seconds": 600
      }
    },
    {
      "id": "trace_policy",
      "service": "invariant",
      "operation": "trace.check",
      "depends_on": [
        "dispatch_policy"
      ],
      "params": {
        "dataset": "demo",
        "events": [
          {
            "kind": "read_private",
            "previous_state": "failed",
            "hypothetical_review": true
          },
          {
            "kind": "send",
            "previous_state": "uncertain",
            "hypothetical_review": false
          }
        ]
      }
    },
    {
      "id": "tool_audit",
      "service": "pyrit",
      "operation": "tools.audit",
      "depends_on": [
        "trace_policy"
      ],
      "params": {
        "dataset": "demo",
        "calls": [
          {
            "tool": "draft",
            "format": "chat",
            "outcome": "invoked",
            "simulated": false
          },
          {
            "tool": "send",
            "format": "responses",
            "outcome": "not_invoked",
            "simulated": false
          },
          {
            "tool": "plan",
            "format": "chat",
            "outcome": "invoked",
            "simulated": true
          }
        ]
      }
    },
    {
      "id": "context_budget",
      "service": "llama-cpp",
      "operation": "tokens.check",
      "depends_on": [
        "tool_audit"
      ],
      "params": {
        "dataset": "demo",
        "context_budget_units": 200,
        "response_budget_units": 900,
        "context_limit": 512
      }
    },
    {
      "id": "model_review",
      "service": "granite-guardian",
      "operation": "risk.assess",
      "depends_on": [
        "context_budget"
      ],
      "params": {
        "dataset": "demo",
        "context_budget_units": 200,
        "response_budget_units": 900
      }
    },
    {
      "id": "explanation",
      "service": "interpret",
      "operation": "prediction.explain",
      "depends_on": [
        "model_review"
      ],
      "params": {
